+def r1m_entry_allowed(now):
+    """Only weekday SIP/premarket entries, 04:00 ET to <13:15 CT.
+
+    A negative time window would reopen at 19:00 CT when the data feed
+    switches to BOATS; a positive allow-window fails closed at both ends.
+    This gate is separate from and in addition to broker/newsclear checks.
+    """
+    if not isinstance(now,dt.datetime) or now.tzinfo is None:
+        return False
+    chicago=now.astimezone(CT)
+    eastern=now.astimezone(ET)
+    return (chicago.weekday()<5 and eastern.weekday()<5
+            and dt.time(3,0)<=chicago.time()<dt.time(13,15)
+            and eastern.time()>=dt.time(4,0)
+            and feed_for(now)=='sip')
+
+
+def r1m_flat_due(original_fill_at,now):
+    """Persist 13:40 CT exit eligibility from the original verified fill.
+
+    An overdue lot remains due after midnight, across weekends and into
+    the next supported broker trading session; do not reset at midnight.
+    Actual broker quote/position/order/session preflight is still required.
+    """
+    if not isinstance(now,dt.datetime) or now.tzinfo is None:
+        raise ValueError('R1M_FLAT_CLOCK_UNVERIFIED')
+    original=dp.utc(original_fill_at).astimezone(CT)
+    deadline=original.replace(hour=13,minute=40,second=0,microsecond=0)
+    return now.astimezone(CT)>=deadline
+
+
