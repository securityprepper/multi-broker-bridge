+def record_readback_if_changed(cur,rec_id,result):
+    """Record only new broker FILL evidence, never repeated poll noise.
+
+    The intent's last_checked_utc must still be updated every poll, and
+    subsequent fee/protection checks must still run; no order permissions change.
+    Transaction/intent-row locking remains owned by the existing reconciler.
+    """
+    cur.execute("SELECT evidence_json FROM "+EVENT_TABLE+
+        " WHERE recommendation_id=%s AND event_type='BROKER_FILL_READBACK'"+
+        " ORDER BY id DESC LIMIT 1",(rec_id,))
+    fetched=cur.fetchone()
+    prior=(fetched or {}).get("evidence_json")
+    if prior is not None:
+        try:
+            old=(json.loads(prior) if isinstance(prior,(str,bytes,bytearray))
+                 else prior)
+            if not isinstance(old,dict):
+                raise Unsafe("malformed prior PAPER FILL event evidence")
+        except (ValueError,TypeError) as exc:
+            raise Unsafe("unparseable prior PAPER FILL event evidence") from exc
+        if old==result:
+            return False
+    event(cur,rec_id,"BROKER_FILL_READBACK",result)
+    return True
+
