+def r1m_entry_session_bounds(now):
+    """Aware UTC boundaries for the actual 04:00 ET R1M PAPER entry day.
+
+    Do not use a rolling 24h window: after DST, a broker session can span
+    23/25 elapsed hours. Weekend/overnight permission is handled separately
+    by r1m_entry_allowed; this is ONLY a counting window.
+    """
+    if not isinstance(now,dt.datetime) or now.tzinfo is None:
+        raise ValueError('R1M_SESSION_CLOCK_UNVERIFIED')
+    local=now.astimezone(ET)
+    date=local.date()-(dt.timedelta(days=1) if local.time()<dt.time(4,0)
+                       else dt.timedelta(0))
+    begin=dt.datetime.combine(date,dt.time(4),tzinfo=ET).astimezone(UTC)
+    end=dt.datetime.combine(date+dt.timedelta(days=1),dt.time(4),tzinfo=ET).astimezone(UTC)
+    return begin.isoformat(),end.isoformat()
+
+
