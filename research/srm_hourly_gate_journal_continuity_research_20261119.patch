+def journal_verified_hour(row,now):
+    """Durable episode-hour evidence independent of PAPER routing outcome.
+
+    Journal a verified episode key exactly once BEFORE broker handoff. The
+    caller holds the existing SRM systemd exclusive lock. The record is not
+    an order receipt; order-outcomes-*.jsonl establishes actual broker status.
+    """
+    symbol=row["symbol"]
+    started=row["episode_started_at_utc"]
+    hour=int(row["consecutive_hours"])
+    if hour<1 or not symbol or not started:
+        raise ValueError("INVALID_VERIFIED_EPISODE")
+    path=ROOT/("sustained-alerts-"+now.astimezone(CT).strftime("%Y-%m-%d")+".jsonl")
+    # The same exact episode key must never be re-emitted across calendar
+    # files after a midnight rollover, restart, or interrupted handoff.
+    for existing_path in sorted(ROOT.glob("sustained-alerts-*.jsonl")):
+        if existing_path.is_symlink():
+            raise OSError("JOURNAL_SYMLINK")
+        with existing_path.open(encoding="utf8") as existing:
+            for line in existing:
+                if not line.strip():continue
+                try:prior=json.loads(line)
+                except (ValueError,TypeError):
+                    raise OSError("JOURNAL_CORRUPT")
+                if (prior.get("symbol"),prior.get("first_trend_at_utc"),
+                    prior.get("hour"))==(symbol,started,hour):
+                    return False
+    record={"symbol":symbol,"first_trend_at_utc":started,"hour":hour,
+            "issued_at_utc":now.isoformat(),"verified_at_utc":row["observed"],
+            "latest_price_asof_utc":row["latest_price_asof_utc"],
+            "price_source":row.get("price_source"),"price":row["latest_price"],
+            "changes_pct":row["changes_pct"],
+            "fundamentals":row.get("fundamentals"),
+            "route_status":"ROUTE_OUTCOME_UNKNOWN_USE_ORDER_RECEIPTS",
+            "text":row["alert_text"]}
+    flags=os.O_WRONLY|os.O_APPEND|os.O_CREAT
+    flags|=getattr(os,"O_NOFOLLOW",0)
+    fd=os.open(path,flags,0o600)
+    with os.fdopen(fd,"a",encoding="utf8") as out:
+        out.write(json.dumps(record,sort_keys=True,separators=(",",":"))+"\n")
+        out.flush();os.fsync(out.fileno())
+    return True
 
 
