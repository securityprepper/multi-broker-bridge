+def owned_whole_position_qty(position,entry_side,filled_qty):
+    """Broker-signed whole net position must exclusively match this verified fill.
+
+    Alpaca reports short qty and qty_available as NEGATIVE. Require the
+    correct broker side, exact signed entire position, sufficient *signed*
+    availability, a finite integral fill and no substitute data. A mismatch
+    never authorizes closing an unrelated net position.
+    """
+    if not isinstance(position,dict) or entry_side not in ("buy","sell"):
+        return None
+    if position.get("side")!=("long" if entry_side=="buy" else "short"):
+        return None
+    try:
+        filled=Decimal(str(filled_qty))
+        broker_qty=Decimal(str(position["qty"]))
+        available=Decimal(str(position["qty_available"]))
+        if not all(x.is_finite() for x in (filled,broker_qty,available)):
+            return None
+        if filled<=0 or filled!=filled.to_integral_value():
+            return None
+        signed=filled if entry_side=="buy" else -filled
+        if broker_qty!=signed or available*signed<=0:
+            return None
+        if abs(available)<filled or abs(available)>abs(broker_qty):
+            return None
+        return int(filled)
+    except (KeyError,TypeError,ValueError,ArithmeticError):
+        return None
+
+
+def v2_entry_window(now):
+    """V2 may open only premarket/regular trading before 13:15 CT."""
+    chicago=now.astimezone(CT)
+    eastern=now.astimezone(ET)
+    return (chicago.weekday()<5 and eastern.weekday()<5 and
+            eastern.time()>=dt.time(4,0) and
+            chicago.time()<dt.time(13,15))
+
+
+def paper_exit_window(now):
+    """Limit PAPER close orders to actual ET premarket/RTH/after-hours."""
+    eastern=now.astimezone(ET)
+    return (eastern.weekday()<5 and
+            dt.time(4,0)<=eastern.time()<dt.time(20,0))
+
+
+def session_flat_due(signal_at,now):
+    """13:40 CT deadline is sticky across session boundaries and overnight.
+
+    A stale or previous-session open lot remains due; there is no upper
+    clock bound that silently disables its forced close overnight.
+    """
+    entry=utc(signal_at).astimezone(CT)
+    deadline=entry.replace(hour=13,minute=40,second=0,microsecond=0)
+    return now.astimezone(CT)>=deadline
+
+
