+def paper_outcome_label(result):
+    """Distinguish a no-POST policy veto from an actual broker attempt.
+
+    Keep failed and unknown submissions visible; do not claim a FILL when
+    Alpaca merely accepts an order or the API times out.
+    """
+    broker_outcome=str(result.get("status","UNKNOWN"))[:120]
+    reason=str(result.get("reason",""))[:100]
+    if broker_outcome.startswith("BROKER_ACCEPTED"):
+        return "PAPER ORDER ACCEPTED (NOT A FILLED TRADE)"
+    if broker_outcome=="PAPER_CLOSE_ACCEPTED_NOT_A_FILL":
+        return "PAPER CLOSE ACCEPTED (NOT A FILLED TRADE)"
+    if broker_outcome=="NO_HELD_POSITION":
+        return "ALPACA PAPER: NO POSITION HELD; NO SELL ORDER NEEDED (NOT A BROKER FAILURE)"
+    if broker_outcome.startswith(("CLOSE_BLOCKED_","CANCEL_REQUESTED_","BUY_CANCEL_",
+          "PROTECTIVE_SELL_","OPEN_ORDER_","POSITIONS_","LATEST_POSITION_",
+          "POST_CANCEL_","MARKET_CLOSED_")) or broker_outcome.endswith("_NO_CLOSE"):
+        return "PAPER EXIT PROTECTION / VERIFICATION BLOCKED; NO CONFIRMED SELL: "+broker_outcome
+    if broker_outcome=="NO_ORDER_OUTSIDE_RTH_BRACKET_WINDOW":
+        return "NOT ELIGIBLE: after protected 13:15 CT PAPER entry cutoff; NO ORDER SENT"
+    if broker_outcome in ("NO_ORDER_OR_UNKNOWN_NO_RETRY","UNKNOWN_NO_RETRY") or "UNKNOWN_NO_RETRY" in broker_outcome:
+        return "PAPER SUBMISSION STATUS UNKNOWN / DO NOT RETRY; verify broker order readback: "+broker_outcome
+    if broker_outcome.startswith("NO_ORDER_"):
+        suffix=(": "+reason) if reason else ""
+        return "PAPER BUY NOT ELIGIBLE / SAFETY GATE, NO BROKER POST: "+broker_outcome+suffix
+    return "PAPER ORDER ATTEMPT REJECTED OR FAILED (NOT FILLED): "+broker_outcome
+
+
