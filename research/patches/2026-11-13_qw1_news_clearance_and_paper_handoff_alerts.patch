+def trusted_buy_eligibility(symbol, now):
+    """Pure read-only root attestor: current licensed news cache is NOT clearance.
+
+    When no trusted signed issuer/SEC/licensed-news source proof exists, a
+    price-based BUY signal remains WATCH/NO_ORDER. Existing-position risk
+    alerts and PAPER SELL/flatten are separate and never blocked by this.
+    """
+    if now.tzinfo is None:
+        return False,"NEWS_CLOCK_UNKNOWN"
+    local=now.astimezone(CT)
+    if not (time(8,30)<=local.time()<time(13,15) and local.weekday()<5):
+        return False,"PAST_1315_PAPER_ENTRY_CUTOFF"
+    try:
+        proof=root_news_clear(symbol,now)
+        if not isinstance(proof,dict) or proof.get("status")!="NEWS_CLEAR_ASOF":
+            return False,"NEWS_UNKNOWN_NO_VERIFIED_CLEARANCE"
+    except NewsBlocked as exc:
+        return False,str(exc.status)
+    except (OSError,ValueError,KeyError,TypeError,ImportError):
+        return False,"NEWS_UNKNOWN_ATTESTATION_UNAVAILABLE"
+    return True,"NEWS_CLEAR_ASOF"
+
 
